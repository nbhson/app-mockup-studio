{
  "name": "@ai-mockup-studio/root",
  "version": "0.0.1",
  "private": true,
  "description": "AI Mockup Studio — Monorepo root",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ai-mockup-studio/web",
    "dev:api": "turbo run dev --filter=@ai-mockup-studio/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@ai-mockup-studio/web",
    "build:api": "turbo run build --filter=@ai-mockup-studio/api",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @ai-mockup-studio/api db:generate",
    "db:migrate": "pnpm --filter @ai-mockup-studio/api db:migrate",
    "db:push": "pnpm --filter @ai-mockup-studio/api db:push",
    "db:seed": "pnpm --filter @ai-mockup-studio/api db:seed",
    "db:studio": "pnpm --filter @ai-mockup-studio/api db:studio",
    "eval:ai": "pnpm --filter @ai-mockup-studio/api eval:ai",
    "e2e:api": "pnpm --filter @ai-mockup-studio/api e2e:api",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,css}\" --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "packageManager": "pnpm@12.16.1",
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  }
}
