# --- Database (PostgreSQL, Drizzle ORM) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_mockup_studio"

# --- AI Provider (optional). If empty, the API uses a built-in mock generator
#     so the MVP works end-to-end without any API key. Set OPENAI_API_KEY to
#     enable real LLM generation + editing via an OpenAI-compatible endpoint. ---
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- API ---
PORT=3000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Max AI requests per IP per minute (generation/editing).
AI_RATE_LIMIT=20
# Optional bearer token required by GET /api/metrics (leave empty in local dev).
METRICS_TOKEN=""
# Log a warning for requests slower than this (ms).
SLOW_REQUEST_MS=750
APP_VERSION="0.1.0"
# Simple alert thresholds surfaced in GET /api/metrics -> alerts[].
METRICS_ERROR_RATE_THRESHOLD=0.05
METRICS_P95_MS_THRESHOLD=1000
METRICS_AI_FALLBACK_THRESHOLD=0.2
