# --- Database (PostgreSQL, Drizzle ORM) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_mockup_studio"

# --- AI Provider (optional). If empty, the API uses a built-in mock generator
#     so the MVP works end-to-end without any API key. Set OPENAI_API_KEY to
#     enable real LLM generation + editing via an OpenAI-compatible endpoint. ---
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Per-attempt ceiling for one LLM call. Reasoning models (qwen3, o-series,
# deepseek-r1) spend 60–120 s writing a full page of JSON, so this must stay
# above that or every attempt is aborted and the offline mockup is used.
AI_TIMEOUT_MS=90000
# Total wall-clock budget for one user-facing AI action, retries included.
# The pipeline stops early (and falls back) instead of stacking 3 × 90 s.
AI_BUDGET_MS=150000
# Upper bound for the output token budget when a reply gets truncated.
AI_MAX_OUTPUT_TOKENS=20000
# Thinking budget for reasoning models: minimal | low | medium | high | off.
# A thinking model spends most of its time "reasoning" before it writes any
# JSON (~30 s at minimal vs ~135 s by default for one page), which is how calls
# end up past AI_TIMEOUT_MS. "off" sends nothing and keeps the endpoint default.
AI_REASONING_EFFORT="low"

# --- API ---
PORT=3000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Max AI requests per IP per minute (generation/editing).
AI_RATE_LIMIT=20
# Optional Redis URL for shared (multi-instance) rate limiting.
# When empty, the API uses an in-memory limiter (single instance).
REDIS_URL=""
# Optional bearer token required by GET /api/metrics (leave empty in local dev).
METRICS_TOKEN=""
# Log a warning for requests slower than this (ms).
SLOW_REQUEST_MS=750
APP_VERSION="0.1.0"
# Simple alert thresholds surfaced in GET /api/metrics -> alerts[].
METRICS_ERROR_RATE_THRESHOLD=0.05
METRICS_P95_MS_THRESHOLD=1000
METRICS_AI_FALLBACK_THRESHOLD=0.2
