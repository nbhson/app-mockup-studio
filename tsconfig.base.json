{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@ai-mockup-studio/ui-schema": ["packages/ui-schema/src/index.ts"],
      "@ai-mockup-studio/ui-renderer": ["packages/ui-renderer/src/index.ts"],
      "@ai-mockup-studio/design-system": ["packages/design-system/src/index.ts"],
      "@ai-mockup-studio/ai-core": ["packages/ai-core/src/index.ts"],
      "@ai-mockup-studio/ai-prompts": ["packages/ai-prompts/src/index.ts"],
      "@ai-mockup-studio/shared-types": ["packages/shared-types/src/index.ts"],
      "@ai-mockup-studio/validators": ["packages/validators/src/index.ts"]
    }
  }
}
