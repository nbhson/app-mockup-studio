{
  "name": "@ai-mockup-studio/validators",
  "version": "0.1.0",
  "description": "Zod schemas — runtime validation for UI schema, patches and API bodies",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-mockup-studio/ui-schema": "workspace:*",
    "@ai-mockup-studio/shared-types": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
